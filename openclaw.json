{
  "gateway": {
    "mode": "local",
    "bind": "lan",
    "port": 18789,
    "controlUi": {
      "enabled": true,
      "allowInsecureAuth": true
    },
    "auth": {
      "mode": "token"
    },
    "trustedProxies": ["0.0.0.0/0"]
  },
  "models": {
    "mode": "merge",
    "providers": {
      "openrouter": {
        "baseUrl": "https://openrouter.ai/api/v1",
        "apiKey": "${OPENROUTER_API_KEY}",
        "api": "openai-completions",
        "models": [
          {
            "id": "google/gemini-2.5-flash",
            "name": "Gemini 2.5 Flash (OpenRouter)",
            "input": ["text", "image"],
            "contextWindow": 1048576,
            "maxTokens": 65535
          },
          {
            "id": "openrouter/free",
            "name": "Free Auto-Router (OpenRouter)",
            "input": ["text"],
            "contextWindow": 200000,
            "maxTokens": 8192
          }
        ]
      },
      "polza": {
        "baseUrl": "${POLZA_BASE_URL}",
        "apiKey": "${POLZA_API_KEY}",
        "api": "openai-completions",
        "models": [
          {
            "id": "google/gemini-2.5-flash",
            "name": "Gemini 2.5 Flash (Polza)",
            "input": ["text", "image"],
            "contextWindow": 1000000,
            "maxTokens": 8192
          },
          {
            "id": "x-ai/grok-4.1-fast",
            "name": "Grok 4.1 Fast (Polza)",
            "input": ["text"],
            "contextWindow": 2000000,
            "maxTokens": 8192
          }
        ]
      }
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "openrouter/google/gemini-2.5-flash",
        "fallbacks": [
          "openrouter/openrouter/free",
          "polza/google/gemini-2.5-flash"
        ]
      },
      "workspace": "/home/node/.openclaw/workspace"
    }
  },
  "messages": {
    "tts": {
      "auto": "inbound",
      "provider": "edge",
      "edge": {
        "voice": "ru-RU-SvetlanaNeural",
        "lang": "ru-RU",
        "outputFormat": "audio-24khz-48kbitrate-mono-mp3",
        "rate": "+0%",
        "pitch": "+0%"
      }
    }
  },
  "channels": {
    "telegram": {
      "enabled": true,
      "dmPolicy": "allowlist",
      "allowFrom": [5259939296],
      "groupPolicy": "allowlist",
      "streamMode": "partial"
    }
  },
  "browser": {
    "enabled": true,
    "headless": true,
    "noSandbox": true,
    "defaultProfile": "steel",
    "profiles": {
      "steel": {
        "cdpUrl": "${STEEL_CDP_URL}"
      }
    }
  },
  "tools": {
    "web": {
      "search": {
        "enabled": true,
        "provider": "brave",
        "apiKey": "${BRAVE_API_KEY}"
      },
      "fetch": {
        "enabled": true
      }
    },
    "media": {
      "audio": {
        "models": [
          {
            "provider": "groq",
            "model": "whisper-large-v3-turbo"
          }
        ],
        "language": "ru"
      }
    }
  },
  "skills": {
    "entries": {
      "n8n-api": {
        "enabled": true
      },
      "tg-kombain": {
        "enabled": true
      },
      "agent-delegate": {
        "enabled": true
      },
      "telegram-voice": {
        "enabled": false
      }
    }
  },
  "hooks": {
    "enabled": true,
    "path": "/hooks",
    "token": "${OPENCLAW_HOOKS_TOKEN}",
    "mappings": [
      {
        "id": "agent-result",
        "match": { "path": "/agent" },
        "action": "agent",
        "sessionKey": "agent:default",
        "messageTemplate": "Agent result received"
      }
    ]
  },
  "plugins": {
    "entries": {
      "telegram": {
        "enabled": true
      }
    }
  }
}
