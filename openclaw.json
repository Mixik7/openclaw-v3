{
  "gateway": {
    "mode": "local",
    "bind": "lan",
    "port": 18789,
    "controlUi": {
      "enabled": true,
      "allowInsecureAuth": true
    },
    "auth": {
      "mode": "token"
    },
    "trustedProxies": ["0.0.0.0/0"]
  },
  "models": {
    "mode": "merge",
    "providers": {
      "cliproxy": {
        "baseUrl": "${CLIPROXY_BASE_URL}",
        "apiKey": "${CLIPROXY_API_KEY}",
        "api": "openai-completions",
        "models": [
          {
            "id": "claude-sonnet-4-6",
            "name": "Claude Sonnet 4.6 (Antigravity)",
            "input": ["text", "image"],
            "contextWindow": 200000,
            "maxTokens": 8192
          },
          {
            "id": "claude-sonnet-4-5",
            "name": "Claude Sonnet 4.5 (Antigravity)",
            "input": ["text", "image"],
            "contextWindow": 200000,
            "maxTokens": 8192
          },
          {
            "id": "claude-opus-4-6-thinking",
            "name": "Claude Opus 4.6 Thinking (Antigravity)",
            "reasoning": true,
            "input": ["text", "image"],
            "contextWindow": 200000,
            "maxTokens": 16384
          },
          {
            "id": "gemini-3-pro-high",
            "name": "Gemini 3 Pro (Antigravity)",
            "input": ["text", "image"],
            "contextWindow": 1000000,
            "maxTokens": 8192
          }
        ]
      }
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "cliproxy/gemini-3-pro-high",
        "fallbacks": ["cliproxy/claude-sonnet-4-6"]
      },
      "workspace": "/home/node/.openclaw/workspace"
    }
  },
  "messages": {
    "tts": {
      "auto": "off",
      "provider": "edge",
      "edge": {
        "voice": "ru-RU-SvetlanaNeural",
        "lang": "ru-RU",
        "outputFormat": "ogg-24khz-16bit-mono-opus",
        "rate": "+0%",
        "pitch": "+0%"
      }
    }
  },
  "channels": {
    "telegram": {
      "enabled": true,
      "dmPolicy": "allowlist",
      "allowFrom": [5259939296],
      "groupPolicy": "allowlist",
      "streamMode": "partial"
    }
  },
  "skills": {
    "entries": {
      "n8n-api": {
        "enabled": true
      },
      "tg-kombain": {
        "enabled": true
      },
      "agent-delegate": {
        "enabled": true
      },
      "telegram-voice": {
        "enabled": true
      }
    }
  },
  "hooks": {
    "enabled": true,
    "path": "/hooks",
    "token": "${OPENCLAW_HOOKS_TOKEN}",
    "mappings": [
      {
        "id": "agent-result",
        "match": { "path": "/agent" },
        "action": "agent",
        "sessionKey": "agent:default",
        "messageTemplate": "Agent result received"
      }
    ]
  },
  "plugins": {
    "entries": {
      "telegram": {
        "enabled": true
      }
    }
  }
}
