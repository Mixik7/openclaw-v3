{
  "gateway": {
    "mode": "local",
    "bind": "lan",
    "port": 18789,
    "controlUi": {
      "enabled": true,
      "allowInsecureAuth": true
    },
    "auth": {
      "mode": "token"
    },
    "trustedProxies": ["0.0.0.0/0"]
  },
  "models": {
    "mode": "merge",
    "providers": {
      "polza": {
        "baseUrl": "${POLZA_BASE_URL}",
        "apiKey": "${POLZA_API_KEY}",
        "api": "openai-completions",
        "models": [
          {
            "id": "google/gemini-3-pro-preview",
            "name": "Gemini 3 Pro (Polza)",
            "input": ["text", "image"],
            "contextWindow": 1000000,
            "maxTokens": 8192
          },
          {
            "id": "anthropic/claude-sonnet-4.5",
            "name": "Claude Sonnet 4.5 (Polza)",
            "input": ["text", "image"],
            "contextWindow": 200000,
            "maxTokens": 8192
          },
          {
            "id": "anthropic/claude-opus-4.6",
            "name": "Claude Opus 4.6 (Polza)",
            "reasoning": true,
            "input": ["text", "image"],
            "contextWindow": 200000,
            "maxTokens": 16384
          },
          {
            "id": "google/gemini-3.1-pro-preview",
            "name": "Gemini 3.1 Pro (Polza)",
            "input": ["text", "image"],
            "contextWindow": 1000000,
            "maxTokens": 8192
          }
        ]
      }
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "polza/google/gemini-3-pro-preview",
        "fallbacks": ["polza/anthropic/claude-sonnet-4.5"]
      },
      "workspace": "/home/node/.openclaw/workspace"
    }
  },
  "messages": {
    "tts": {
      "auto": "inbound",
      "provider": "edge",
      "edge": {
        "voice": "ru-RU-SvetlanaNeural",
        "lang": "ru-RU",
        "outputFormat": "ogg-24khz-16bit-mono-opus",
        "rate": "+0%",
        "pitch": "+0%"
      }
    }
  },
  "channels": {
    "telegram": {
      "enabled": true,
      "dmPolicy": "allowlist",
      "allowFrom": [5259939296],
      "groupPolicy": "allowlist",
      "streamMode": "partial"
    }
  },
  "tools": {
    "web": {
      "search": {
        "enabled": true,
        "provider": "brave",
        "apiKey": "${BRAVE_API_KEY}"
      },
      "fetch": {
        "enabled": true
      }
    },
    "media": {
      "audio": {
        "models": [
          {
            "provider": "groq",
            "model": "whisper-large-v3-turbo"
          }
        ],
        "language": "ru"
      }
    }
  },
  "skills": {
    "entries": {
      "n8n-api": {
        "enabled": true
      },
      "tg-kombain": {
        "enabled": true
      },
      "agent-delegate": {
        "enabled": true
      },
      "telegram-voice": {
        "enabled": true
      }
    }
  },
  "hooks": {
    "enabled": true,
    "path": "/hooks",
    "token": "${OPENCLAW_HOOKS_TOKEN}",
    "mappings": [
      {
        "id": "agent-result",
        "match": { "path": "/agent" },
        "action": "agent",
        "sessionKey": "agent:default",
        "messageTemplate": "Agent result received"
      }
    ]
  },
  "plugins": {
    "entries": {
      "telegram": {
        "enabled": true
      }
    }
  }
}
